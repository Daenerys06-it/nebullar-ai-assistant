# Company computer only.
# Copy this file to .env on the company computer:
#   Copy-Item env.company.example .env
#
# Pick ONE provider:
# - Kimi (recommended): LLM_PROVIDER=kimi
# - GPT-5 (when available): LLM_PROVIDER=gpt5

LLM_PROVIDER=kimi

# Kimi: company Anthropic-compatible gateway (recommended)
KIMI_BASE_URL=http://10.10.5.136:8080
KIMI_API_KEY=sk_your_kimi_key_here
KIMI_MODEL=kimi-k2.5

# GPT-5: company Anthropic-compatible gateway (optional fallback)
GPT5_BASE_URL=http://10.10.85.155:3000/openapi
GPT5_AUTH_TOKEN=cr_your_gateway_token_here
GPT5_MODEL=gpt-5

# Optional fallback: if the primary provider fails, retry with this provider.
# Leave empty to disable. If you want fallback to DeepSeek on the company computer,
# also fill DEEPSEEK_API_KEY below.
LLM_FALLBACK_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
