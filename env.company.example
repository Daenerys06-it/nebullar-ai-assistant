# Company computer only.
# Copy this file to .env on the company computer:
#   Copy-Item env.company.example .env
#
# Pick ONE provider:
# - If you are developing with Codex / GPT-5, use: LLM_PROVIDER=gpt5
# - If you are developing with Claude Code / Opus, use: LLM_PROVIDER=opus

LLM_PROVIDER=gpt5

# Codex / GPT-5 path: company Anthropic-compatible GPT gateway.
GPT5_BASE_URL=http://10.10.85.155:3000/openapi
GPT5_AUTH_TOKEN=cr_your_gateway_token_here
GPT5_MODEL=gpt-5

# Claude Code / Opus path: company Anthropic-compatible Opus gateway.
ANTHROPIC_BASE_URL=http://10.10.85.155:3000/api
ANTHROPIC_AUTH_TOKEN=cr_your_gateway_token_here
OPUS_MODEL=claude-opus-4-8

# Optional fallback: if the primary provider fails, retry with this provider.
# Leave empty to disable. If you want fallback to DeepSeek on the company computer,
# also fill DEEPSEEK_API_KEY below.
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

