# Home computer only.
# Copy this file to .env on the home computer:
#   Copy-Item env.home.example .env
#
# Home cannot reach the company gateway, so always use DeepSeek.

LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat

# Company gateway variables are intentionally absent here.
# Keep home config simple: no Kimi, no GPT-5.
