# 选择 LLM 提供方：opus(公司电脑,走内网网关) | deepseek(家里电脑)
# 公司电脑设 opus；家里电脑连不上网关，设 deepseek
LLM_PROVIDER=opus

# —— 公司电脑：Anthropic 兼容网关（Claude Opus 4.8）——
# anthropic SDK 自动读取：ANTHROPIC_BASE_URL 指向网关，ANTHROPIC_AUTH_TOKEN 作为 Bearer 令牌
ANTHROPIC_BASE_URL=http://your-gateway-host:3000/api
ANTHROPIC_AUTH_TOKEN=cr_your_token_here

# —— 家庭电脑：DeepSeek（OpenAI 兼容）——
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# 嵌入模型用本地 sentence-transformers（paraphrase-multilingual-MiniLM-L12-v2），无需 key
